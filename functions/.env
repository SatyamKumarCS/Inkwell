# Non-secret Functions params (committed). Secrets never go here: use `firebase functions:secrets:set`.
# Per-machine overrides for the emulator go in functions/.env.local (git-ignored), e.g. EMAIL_CODE_TTL_SECONDS=30.
EMAIL_FROM="Inkwell <onboarding@resend.dev>"
EMAIL_CODE_TTL_SECONDS=600
AUTH_IP_HOURLY_LIMIT=10
EMAIL_CODE_DAILY_CAP=200
# Web client ID (not a secret) from Firebase > Authentication > Google > Web SDK configuration.
# Empty disables Google sign-in. Used by the emulator too: dev builds get real Google ID tokens.
GOOGLE_WEB_CLIENT_ID=
