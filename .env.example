# Copy to apps/mobile/.env (git-ignored). Only EXPO_PUBLIC_* values reach the app bundle — never put secrets here.

# Use the local Firebase Emulator Suite (true for all local development).
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true
# Host running the emulators. Leave empty to auto-detect the Metro host (works for simulators and phones on the same Wi-Fi).
EXPO_PUBLIC_EMULATOR_HOST=

# Paths to real Firebase app config files (only needed when building against a real Firebase project).
# When unset, the demo configs in apps/mobile/firebase/ are used — they only work with the emulators.
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICES_PLIST=
